# vim:set ft=make:

# Usually, shared objects are not build on !CONFIG_MMU. But Makefile.libgcc
# picks up the dependency before lib.mk can filter it.
TARGET          = $(if $(CONFIG_MMU),libgcc_s.so)
PC_FILENAME     = libgcc_s

REQUIRES_LIBS   = libgcc-headers libc
# Avoid circular dependency, as this package is part of the compiler runtime.
COMPILER_RT     =

LIBGCC_PKG_DIR  = $(PKGDIR)/../libgcc
include $(LIBGCC_PKG_DIR)/build/src/Makefile.libgcc
