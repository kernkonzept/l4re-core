menu "Moe"
	visible if EXPERT

config MOE_DEBUG_NAMES
	bool "Set jdb names for created kernel objects"
	help
	  With this option enabled, Moe will register names in jdb for all
	  objects it creates.

	  This is a debugging and development feature.

config MOE_BOOT_FB
	bool "Pass-on the bootloader's frame buffer"
	default y
	help
	  Add support to expose the bootloader's frame buffer as special
	  dataspace.

	  If unsure, say y.

endmenu
